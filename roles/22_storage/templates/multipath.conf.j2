defaults {
        find_multipaths strict
        polling_interval 2
        path_selector "round-robin 0"
        path_grouping_policy multibus
        uid_attribute ID_SERIAL
        rr_min_io 100
        failback immediate
        no_path_retry queue
        user_friendly_names yes
}
blacklist {
        wwid .*
}
blacklist_exceptions {
        wwid {{ multipath_wwid}}
}
multipaths {
        multipath {
                wwid {{ multipath_wwid }}
                alias {{ multipath_alias}}
        }
}
